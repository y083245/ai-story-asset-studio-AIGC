# Story Asset Studio environment template
# Copy this file to .env and fill in your provider keys.

# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
PROVIDER_MODE=auto
USER_AUTH_MODE=dev-header
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://storyasset:storyasset@localhost:5432/storyasset
DATABASE_URL_SYNC=postgresql://storyasset:storyasset@localhost:5432/storyasset

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage
OBJECT_STORAGE_PROVIDER=local
CDN_BASE_URL=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_REGION=
TOS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# Text analysis
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_FAST_MODEL_NAME=deepseek-chat
DEEPSEEK_STRONG_MODEL_NAME=deepseek-chat
DEEPSEEK_DEFAULT_THINKING=disabled
ANALYSIS_CHUNK_CONCURRENCY=3
ANALYSIS_CHUNK_RETRY_LIMIT=1
ANALYSIS_CHUNK_RESULT_CACHE=true
DEEPSEEK_FLASH_CONCURRENCY=10
DEEPSEEK_PRO_CONCURRENCY=5

# Image generation
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=
SEEDREAM_MODEL_NAME=doubao-seedream-5-0-lite-260128

# Image quality
VISION_QUALITY_MODEL_NAME=doubao-vision-quality
