{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://story-asset-studio.dev/schemas/prop.schema.json",
  "title": "Prop",
  "description": "A story-significant object extracted from the novel.",
  "type": "object",
  "required": [
    "prop_id",
    "name",
    "owner_character_id",
    "first_appearance",
    "visual_features",
    "material",
    "color",
    "size",
    "function_in_story",
    "state_timeline",
    "prop_prompt",
    "usage_prompt"
  ],
  "properties": {
    "prop_id": {
      "type": "string",
      "pattern": "^PR_\\d{3}$",
      "description": "Stable prop ID, e.g. PR_001."
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "owner_character_id": {
      "type": "string",
      "description": "Character ID of the prop's owner."
    },
    "first_appearance": { "type": "string" },
    "visual_features": { "type": "string" },
    "material": { "type": "string" },
    "color": { "type": "string" },
    "size": { "type": "string" },
    "function_in_story": { "type": "string" },
    "state_timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Ordered timeline of the prop's state changes. Required for core props."
    },
    "prop_prompt": {
      "type": "string",
      "description": "Image-generation prompt for the prop on a plain background."
    },
    "usage_prompt": {
      "type": "string",
      "description": "Image-generation prompt showing the prop in use."
    }
  },
  "additionalProperties": false
}
