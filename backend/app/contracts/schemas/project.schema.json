{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://story-asset-studio.dev/schemas/project.schema.json",
  "title": "Project",
  "description": "A novel-to-visual-assets project.",
  "type": "object",
  "required": [
    "project_id",
    "title",
    "aspect_ratio",
    "style_mode",
    "generation_mode",
    "status"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "description": "UUID string."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9"
      ],
      "description": "Image asset aspect ratio."
    },
    "style_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ]
    },
    "manual_style": {
      "type": "string"
    },
    "generation_mode": {
      "type": "string",
      "enum": [
        "fast_preview",
        "high_quality"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "uploaded",
        "analyzing",
        "analysis_confirmed",
        "generating_assets",
        "completed",
        "failed",
        "archived"
      ]
    }
  },
  "additionalProperties": false
}
